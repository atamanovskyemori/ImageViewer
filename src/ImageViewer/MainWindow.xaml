<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:ImageViewer.Navigation"
        xmlns:thumb="clr-namespace:ImageViewer.Thumbnails"
        xmlns:meta="clr-namespace:ImageViewer.Metadata"
        Title="ImageViewer"
        Width="1024" Height="720"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- アイコンは Windows 標準のアイコンフォントを使う（Win11: Segoe Fluent Icons / Win10: Segoe MDL2 Assets） -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolBarIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <!-- ボタンにフォーカスが移ると Space / Enter がボタン側に取られるので、フォーカスを持たせない -->
        <Style x:Key="ToolBarButton" TargetType="Button"
               BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- 押したままの状態を見せるボタン（情報パネルの開閉） -->
        <Style x:Key="ToolBarToggleButton" TargetType="ToggleButton"
               BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!--
            並び順の選択ボタン。同じ GroupName の中で1つだけ選ばれる。
            ToolBar 標準の見た目（選択中は背景と枠がハイライト）に加えて、選択中は太字にして区別しやすくする。
        -->
        <Style x:Key="SortKeyButton" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="SortKey" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="FontWeight" Value="Bold" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== ツールバー ===== -->
        <ToolBarTray x:Name="ToolBarHost" DockPanel.Dock="Top" IsLocked="True">
            <ToolBar KeyboardNavigation.TabNavigation="None">
                <Button x:Name="RotateLeftButton"
                        Style="{StaticResource ToolBarButton}"
                        ToolTip="左に回転 (L)"
                        IsEnabled="False"
                        Click="RotateLeftButton_Click">
                    <!-- 右回転のアイコンを左右反転して使う -->
                    <TextBlock Style="{StaticResource ToolBarIcon}" Text="&#xE7AD;">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>

                <Button x:Name="RotateRightButton"
                        Style="{StaticResource ToolBarButton}"
                        ToolTip="右に回転 (R)"
                        IsEnabled="False"
                        Click="RotateRightButton_Click">
                    <TextBlock Style="{StaticResource ToolBarIcon}" Text="&#xE7AD;" />
                </Button>

                <Separator />

                <Button x:Name="FullScreenButton"
                        Style="{StaticResource ToolBarButton}"
                        ToolTip="全画面表示 (Enter)"
                        Click="FullScreenButton_Click">
                    <TextBlock x:Name="FullScreenIcon" Style="{StaticResource ToolBarIcon}" Text="&#xE740;" />
                </Button>

                <Separator />

                <!-- 一覧 ⇔ 1枚表示 -->
                <Button x:Name="ThumbnailButton"
                        Style="{StaticResource ToolBarButton}"
                        ToolTip="サムネイル一覧 (T)"
                        IsEnabled="False"
                        Click="ThumbnailButton_Click">
                    <TextBlock x:Name="ThumbnailIcon" Style="{StaticResource ToolBarIcon}" Text="&#xE8A9;" />
                </Button>

                <!-- 画像の情報（EXIF）パネルの開閉 -->
                <ToggleButton x:Name="InfoButton"
                              Style="{StaticResource ToolBarToggleButton}"
                              ToolTip="画像の情報 (I)"
                              Click="InfoButton_Click">
                    <TextBlock Style="{StaticResource ToolBarIcon}" Text="&#xE946;" />
                </ToggleButton>

                <!-- スライドショーの開始 / 停止 -->
                <Button x:Name="SlideshowButton"
                        Style="{StaticResource ToolBarButton}"
                        ToolTip="スライドショー (S)"
                        IsEnabled="False"
                        Click="SlideshowButton_Click">
                    <TextBlock x:Name="SlideshowIcon" Style="{StaticResource ToolBarIcon}" Text="&#xE768;" />
                </Button>

                <Separator />

                <!-- 並び順。Tag に FileSortKey を持たせて、クリック時にそれを読む -->
                <RadioButton x:Name="SortByNameButton"
                             Style="{StaticResource SortKeyButton}"
                             Content="名前"
                             ToolTip="名前順（自然順）"
                             Tag="{x:Static nav:FileSortKey.Name}"
                             Checked="SortKeyButton_Checked" />
                <RadioButton x:Name="SortByDateButton"
                             Style="{StaticResource SortKeyButton}"
                             Content="更新日時"
                             ToolTip="更新日時順"
                             Tag="{x:Static nav:FileSortKey.LastWriteTime}"
                             Checked="SortKeyButton_Checked" />
                <RadioButton x:Name="SortBySizeButton"
                             Style="{StaticResource SortKeyButton}"
                             Content="サイズ"
                             ToolTip="ファイルサイズ順"
                             Tag="{x:Static nav:FileSortKey.Size}"
                             Checked="SortKeyButton_Checked" />

                <!-- 昇順・降順の切り替え。今の状態をアイコンと文字で表示する -->
                <Button x:Name="SortDirectionButton"
                        Style="{StaticResource ToolBarButton}"
                        Click="SortDirectionButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SortDirectionIcon"
                                   Style="{StaticResource ToolBarIcon}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SortDirectionText"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- ===== ステータスバー ===== -->
        <!-- StatusBar の中身は DockPanel なので、右側の項目は Dock="Right" で右から順に並べ、最後のファイル名が残りを埋める -->
        <StatusBar x:Name="StatusBarHost" DockPanel.Dock="Bottom">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="ZoomText" MinWidth="44" TextAlignment="Right" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="PixelSizeText" MinWidth="80" TextAlignment="Right" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <!-- アニメーションのコマ表示（静止画では欄ごと隠す） -->
            <StatusBarItem x:Name="FrameItem" DockPanel.Dock="Right" Visibility="Collapsed">
                <TextBlock x:Name="FrameText" MinWidth="72" TextAlignment="Right" />
            </StatusBarItem>
            <Separator x:Name="FrameSeparator" DockPanel.Dock="Right" Visibility="Collapsed" />
            <!-- スライドショー中だけ出す -->
            <StatusBarItem x:Name="SlideshowItem" DockPanel.Dock="Right" Visibility="Collapsed">
                <TextBlock x:Name="SlideshowText" />
            </StatusBarItem>
            <Separator x:Name="SlideshowSeparator" DockPanel.Dock="Right" Visibility="Collapsed" />
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="IndexText" MinWidth="56" TextAlignment="Right" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem>
                <TextBlock x:Name="FileNameText" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- ===== 画像表示領域（右に情報パネル） ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Canvas は子要素をレイアウトでクリップしないので、
                大きな画像を RenderTransform で拡大・回転・移動しても欠けない。
                はみ出た分は ClipToBounds で切る。
            -->
            <Canvas x:Name="Viewport"
                    Background="#FF1E1E1E"
                    ClipToBounds="True"
                    AllowDrop="True"
                    MouseWheel="Viewport_MouseWheel"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseMove="Viewport_MouseMove"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    LostMouseCapture="Viewport_LostMouseCapture"
                    SizeChanged="Viewport_SizeChanged"
                    DragOver="Viewport_DragOver"
                    Drop="Viewport_Drop">
                <Image x:Name="ImageView"
                       Canvas.Left="0" Canvas.Top="0"
                       Stretch="Fill"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Canvas>

            <!-- サムネイル一覧。表示中は上の画像表示領域を隠す（Viewport は大きさを保つため Hidden にする） -->
            <thumb:ThumbnailGrid x:Name="ThumbnailView"
                                 Visibility="Collapsed"
                                 AllowDrop="True"
                                 DragOver="Viewport_DragOver"
                                 Drop="Viewport_Drop"
                                 SelectionChanged="ThumbnailView_SelectionChanged"
                                 ItemActivated="ThumbnailView_ItemActivated"
                                 ThumbnailSizeChanged="ThumbnailView_ThumbnailSizeChanged" />

            <TextBlock x:Name="MessageText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="24"
                       Foreground="#FFB0B0B0"
                       FontSize="16"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False"
                       Text="画像をドラッグ＆ドロップするか、Ctrl+O で開きます" />

            <!-- 画像の情報。開くと、その分だけ画像表示領域（一覧）が狭くなる -->
            <meta:InfoPanel x:Name="InfoView"
                            Grid.Column="1"
                            Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
