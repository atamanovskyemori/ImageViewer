<UserControl x:Class="ImageViewer.Thumbnails.ThumbnailGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ImageViewer.Thumbnails"
             Background="#FF1E1E1E"
             Focusable="False">

    <!--
        大きさ（ThumbImageSize / ThumbTileWidth / ThumbTileHeight）はコードから Resources に入れる。
        DynamicResource なので、Ctrl+ホイールで変えると見えているタイルもすぐ変わる。
    -->
    <ListBox x:Name="RowList"
             Background="Transparent"
             BorderThickness="0"
             Padding="4"
             Focusable="False"
             KeyboardNavigation.DirectionalNavigation="None"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.CanContentScroll="True"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel"
             ScrollViewer.ScrollChanged="RowList_ScrollChanged"
             PreviewMouseWheel="RowList_PreviewMouseWheel"
             PreviewMouseLeftButtonDown="RowList_PreviewMouseLeftButtonDown"
             SizeChanged="RowList_SizeChanged">

        <!-- 行（ListBoxItem）は選択もフォーカスもさせない。選択はタイルごとに自分で管理する -->
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type local:ThumbnailRow}">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <!-- タイルの作りを変えたら ThumbnailLayout.ChromeWidth / ChromeHeight も合わせること -->
                        <DataTemplate DataType="{x:Type local:ThumbnailItem}">
                            <Grid x:Name="Tile"
                                  Width="{DynamicResource ThumbTileWidth}"
                                  Height="{DynamicResource ThumbTileHeight}"
                                  Background="Transparent"
                                  ToolTip="{Binding FileName}">
                                <Border x:Name="Frame"
                                        Margin="3"
                                        BorderThickness="2"
                                        CornerRadius="3"
                                        BorderBrush="Transparent"
                                        Background="Transparent">
                                    <DockPanel Margin="3">
                                        <TextBlock DockPanel.Dock="Bottom"
                                                   Height="18"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding FileName}"
                                                   Foreground="#FFD0D0D0"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Width="{DynamicResource ThumbImageSize}"
                                              Height="{DynamicResource ThumbImageSize}">
                                            <Image Source="{Binding Image}"
                                                   Stretch="Uniform"
                                                   StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <!-- 読めなかった画像の代わりの印 -->
                                            <TextBlock x:Name="FailedMark"
                                                       Text="&#xE783;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="#FF808080"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <DataTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Frame" Property="Background" Value="#18FFFFFF" />
                                </Trigger>
                                <!-- 選択中はマウスオーバーより優先（後に書いたものが勝つ） -->
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Frame" Property="BorderBrush" Value="#FF3A96DD" />
                                    <Setter TargetName="Frame" Property="Background" Value="#303A96DD" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                    <Setter TargetName="FailedMark" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
