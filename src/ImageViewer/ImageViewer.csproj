<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ImageViewer</RootNamespace>
    <AssemblyName>ImageViewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <!-- ランタイム前提の軽量exe（framework-dependent）。実行には .NET 10 Desktop Runtime が必要 -->
    <SelfContained>false</SelfContained>
    <!-- 同梱する libwebp.dll が x64 版なので、exe も x64 に固定する（AnyCPU だと ARM64 機などで DLL と合わなくなる） -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    WebP用のネイティブDLL（libwebp.dll / libwebpdemux.dll / libsharpyuv.dll）。
    リポジトリ直下の native/x64/ に含めていて、ビルド時に出力フォルダへコピーされる。
    外してもビルド・実行はできる（WICのみで動く）。
    libwebp のライセンス文（COPYING）も libwebp-COPYING.txt という名前で一緒にコピーする。
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\x64\*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\native\x64\COPYING"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\x64\COPYING')"
          Link="libwebp-COPYING.txt"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
