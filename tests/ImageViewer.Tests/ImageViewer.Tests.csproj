<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- BitmapSource（WPF）を使うので、本体と同じく Windows 向けの WPF 有効で作る -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 本体が x64 固定なので合わせる（違うと参照時に警告が出る） -->
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSTest 一式（テストフレームワーク / アダプタ / Microsoft.NET.Test.Sdk を含むメタパッケージ） -->
    <PackageReference Include="MSTest" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageViewer\ImageViewer.csproj" />
  </ItemGroup>

</Project>
