<UserControl x:Class="ImageViewer.Metadata.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ImageViewer.Metadata"
             Width="300"
             Background="#FF252526"
             Focusable="False">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="CopyMenuItem" Header="情報をコピー" Click="CopyMenuItem_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <DockPanel>
        <!-- 画像表示領域との境目 -->
        <Border DockPanel.Dock="Left" Width="1" Background="#FF3F3F46" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="True"
                      KeyboardNavigation.TabNavigation="None">
            <StackPanel Margin="12,6,12,12">
                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           Foreground="#FF909090"
                           TextWrapping="Wrap"
                           Text="画像が開かれていません" />

                <ItemsControl x:Name="SectionList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:InfoSection}">
                            <StackPanel Margin="0,6,0,4">
                                <TextBlock Text="{Binding Title}"
                                           Margin="0,0,0,4"
                                           FontWeight="Bold"
                                           Foreground="#FF6CB4F0" />
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:InfoRow}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Foreground="#FF909090"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           Foreground="#FFE0E0E0"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
