<UserControl x:Class="ImageViewer.Metadata.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ImageViewer.Metadata"
             Background="#FF252526"
             Focusable="False">

    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem x:Name="CopyPromptMenuItem" Header="プロンプトをコピー" Click="CopyPromptMenuItem_Click" />
            <MenuItem x:Name="CopyNegativeMenuItem" Header="ネガティブプロンプトをコピー" Click="CopyNegativeMenuItem_Click" />
            <Separator />
            <MenuItem x:Name="CopyMenuItem" Header="情報をコピー" Click="CopyMenuItem_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <!-- 幅は MainWindow 側の列で決まる（境目をドラッグして変える） -->
    <DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="True"
                      KeyboardNavigation.TabNavigation="None">
            <StackPanel Margin="12,6,12,12">
                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           Foreground="#FF909090"
                           TextWrapping="Wrap"
                           Text="画像が開かれていません" />

                <!-- 項目名の列の幅を、全部の見出しでそろえる（Grid.IsSharedSizeScope と SharedSizeGroup） -->
                <ItemsControl x:Name="SectionList" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:InfoSection}">
                            <StackPanel Margin="0,6,0,4">
                                <TextBlock Text="{Binding Title}"
                                           Margin="0,0,0,4"
                                           FontWeight="Bold"
                                           Foreground="#FF6CB4F0" />
                                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:InfoRow}">
                                            <!--
                                                項目名の列は、いちばん長い項目名に合わせる（どの見出しでも同じ幅）。
                                                ただし値の欄が狭くなりすぎないよう、140 を超える項目名だけ折り返す
                                            -->
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="104" SharedSizeGroup="Label" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Margin="0,0,8,0"
                                                           MaxWidth="140"
                                                           Foreground="#FF909090"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           Foreground="#FFE0E0E0"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
