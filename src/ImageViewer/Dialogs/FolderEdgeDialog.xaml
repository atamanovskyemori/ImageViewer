<Window x:Class="ImageViewer.Dialogs.FolderEdgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageViewer"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="MessageText"
                   MaxWidth="460"
                   Margin="0,0,0,18"
                   TextWrapping="Wrap" />

        <!-- ← → でもボタンを移れるようにする -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    KeyboardNavigation.DirectionalNavigation="Cycle">
            <Button x:Name="MoveButton"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Click="MoveButton_Click" />
            <Button x:Name="WrapButton"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="12,4"
                    Click="WrapButton_Click" />
            <Button x:Name="CancelButton"
                    MinWidth="88"
                    Padding="12,4"
                    Content="キャンセル"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
